rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public read-only access to Holy Quran collections
    match /surahs/{surahId} {
      allow read: if true;
      allow write: if false;

      match /verses/{verseId} {
        allow read: if true;
        allow write: if false;
      }
    }

    match /juzs/{juzId} {
      allow read: if true;
      allow write: if false;
    }

    match /metadata/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Default deny for anything else
    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
