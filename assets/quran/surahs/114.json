[{"k":"114:1","n":1,"t":"قُلْ أَعُوذُ بِرَبِّ ٱلنَّاسِ","tr":"Say, \"I seek refuge in the Lord of mankind,","tf":"قل -أيها الرسول-: أعوذ وأعتصم برب الناس، القادر وحده على ردِّ شر الوسواس.","pg":604,"j":30,"rb":240,"s":false,"w":[{"p":1,"t":"قُلْ"},{"p":2,"t":"أَعُوذُ"},{"p":3,"t":"بِرَبِّ"},{"p":4,"t":"ٱلنَّاسِ"}]},{"k":"114:2","n":2,"t":"مَلِكِ ٱلنَّاسِ","tr":"The Sovereign of mankind.","tf":"ملك الناس المتصرف في كل شؤونهم، الغنيِّ عنهم.","pg":604,"j":30,"rb":240,"s":false,"w":[{"p":1,"t":"مَلِكِ"},{"p":2,"t":"ٱلنَّاسِ"}]},{"k":"114:3","n":3,"t":"إِلَٰهِ ٱلنَّاسِ","tr":"The God of mankind,","tf":"إله الناس الذي لا معبود بحق سواه.","pg":604,"j":30,"rb":240,"s":false,"w":[{"p":1,"t":"إِلَٰهِ"},{"p":2,"t":"ٱلنَّاسِ"}]},{"k":"114:4","n":4,"t":"مِن شَرِّ ٱلْوَسْوَاسِ ٱلْخَنَّاسِ","tr":"From the evil of the retreating whisperer -","tf":"من أذى الشيطان الذي يوسوس عند الغفلة، ويختفي عند ذكر الله.","pg":604,"j":30,"rb":240,"s":false,"w":[{"p":1,"t":"مِن"},{"p":2,"t":"شَرِّ"},{"p":3,"t":"ٱلْوَسْوَاسِ"},{"p":4,"t":"ٱلْخَنَّاسِ"}]},{"k":"114:5","n":5,"t":"ٱلَّذِى يُوَسْوِسُ فِى صُدُورِ ٱلنَّاسِ","tr":"Who whispers [evil] into the breasts of mankind -","tf":"الذي يبثُّ الشر والشكوك في صدور الناس.","pg":604,"j":30,"rb":240,"s":false,"w":[{"p":1,"t":"ٱلَّذِى"},{"p":2,"t":"يُوَسْوِسُ"},{"p":3,"t":"فِى"},{"p":4,"t":"صُدُورِ"},{"p":5,"t":"ٱلنَّاسِ"}]},{"k":"114:6","n":6,"t":"مِنَ ٱلْجِنَّةِ وَٱلنَّاسِ","tr":"From among the jinn and mankind.\"","tf":"من شياطين الجن والإنس.","pg":604,"j":30,"rb":240,"s":false,"w":[{"p":1,"t":"مِنَ"},{"p":2,"t":"ٱلْجِنَّةِ"},{"p":3,"t":"وَٱلنَّاسِ"}]}]